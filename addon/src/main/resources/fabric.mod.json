  },
  "license": "MIT",
  "icon": "assets/flyui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.dnocoder.flyui.FlyUiMod"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-lifecycle-events-v1": "*",
